{
  "name": "advanced-discord-bot-template",
  "version": "1.0.0",
  "description": "Advanced Discord bot template with structured commands, event handling, and rich logging.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:studio": "drizzle-kit studio",
    "register:global": "tsx src/scripts/register-commands.ts --scope global",
    "register:guild": "tsx src/scripts/register-commands.ts --scope guild"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "discord.js": "^14.27.0",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "mysql2": "^3.24.4",
    "postgres": "^3.4.9",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "drizzle-kit": "^0.31.10",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  }
}
