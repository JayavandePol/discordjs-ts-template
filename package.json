{
  "name": "advanced-discord-bot-template",
  "version": "1.0.0",
  "description": "Advanced Discord bot template with structured commands, event handling, and rich logging.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "lint": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "register:global": "tsx src/scripts/register-commands.ts --scope global",
    "register:guild": "tsx src/scripts/register-commands.ts --scope guild"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "prisma": "^6.19.3",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
