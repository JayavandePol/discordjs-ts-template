# Copy to .env and fill in. Leave optional values empty rather than keeping placeholder text:
# IDs are validated, so "your-id-here" fails at startup.

# ------------------------------------------------------------------
# Discord (required)
# ------------------------------------------------------------------
DISCORD_TOKEN=
# Application ID from the Developer Portal (General Information)
APPLICATION_ID=

# ------------------------------------------------------------------
# Development
# ------------------------------------------------------------------
# Your test server. Guild commands update instantly there, and developer
# commands are only ever registered to this server.
GUILD_ID=

# debug | info | warn | error
LOG_LEVEL=info

# Comma-separated user IDs that may use developer commands (e.g. 123456789012345678,987654321098765432)
DEV_USER_IDS=

# Optional: members with this role inside GUILD_ID also count as developers
DEV_ROLE_ID=

# true: auto-registration publishes globally instead of to GUILD_ID
MULTI_GUILD=false

# Register commands every time the bot starts. Keep false while developing
# (watch mode restarts often); use `npm run register:guild` instead.
AUTO_REGISTER_COMMANDS=false

# ------------------------------------------------------------------
# Error reporting (optional)
# ------------------------------------------------------------------
# Channel that receives error reports with an "Inspect Stack" button (developers only)
ERRORLOGCHANNEL_ID=

# http(s) link for the "Contact Developer" button on error messages
SUPPORT_URL=

# ------------------------------------------------------------------
# Database
# ------------------------------------------------------------------
DB_ENABLED=true

# Empty = SQLite file at ./data/database.sqlite. Other options:
# - SQLite file:      DATABASE_URL=./data/bot.sqlite
# - PostgreSQL:       DATABASE_URL=postgresql://user:password@localhost:5432/discord_bot
# - Turso / libSQL:   DATABASE_URL=libsql://your-db.turso.io (plus DATABASE_AUTH_TOKEN)
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Log every SQL query at debug level
DB_LOGGING=false
