# ------------------------------------------------------------------
# Discord Bot Credentials (Required)
# ------------------------------------------------------------------
DISCORD_TOKEN=your-bot-token-here
APPLICATION_ID=your-application-id

# ------------------------------------------------------------------
# Development & Scope Settings
# ------------------------------------------------------------------
# Optional: Target Discord Server (Guild) ID for fast local testing of commands
GUILD_ID=optional-guild-id-for-dev

# Logging verbosity: "debug" | "info" | "warn" | "error"
LOG_LEVEL=info

# Comma-separated Discord User IDs for bot developers (e.g. 123456789012345678,987654321098765432)
# Developer commands can be used anywhere by these users (including DMs).
DEV_USER_IDS=your-discord-user-id

# Optional: Developer Role ID within a guild (users with this role get developer access in that server)
DEV_ROLE_ID=optional-developer-role-id

# Legacy single developer ID (supports either a User ID or Role ID)
DEV_ID=

# Set to "true" to deploy commands globally instead of strictly to GUILD_ID
MULTI_GUILD=false

# Guard flag: Keep false during active local dev to avoid Discord API command registration rate limits.
# Use `npm run register:guild` or `npm run register:global` instead.
AUTO_REGISTER_COMMANDS=false

# ------------------------------------------------------------------
# Observability & Support
# ------------------------------------------------------------------
# Discord Channel ID where uncaught crashes and error reports will be posted
ERRORLOGCHANNEL_ID=optional-channel-id-for-error-logs

# URL attached to "Contact Developer" buttons on error embeds (e.g., support server or ticket link)
SUPPORT_URL=https://discord.gg/your-support-server

# ------------------------------------------------------------------
# Database Configuration (Prisma)
# ------------------------------------------------------------------
# Set to "true" or "false" to control database connectivity
DB_ENABLED=true

# Database storage path for SQLite
DB_STORAGE=./data/database.sqlite

# Enable raw SQL / query logging in the console
DB_LOGGING=false

# Full database connection string (e.g., "file:./data/database.sqlite" or "postgresql://user:pass@localhost:5432/bot")
DATABASE_URL=file:./data/database.sqlite
